<Page x:Class="LibraryGUI.Views.CreateBooks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LibraryGUI.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CreateBooks">

    <Grid Background="White">
        <StackPanel Margin="10,10,10,10">
            <Label Content="Book hozzáadása" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Top" Height="32" Width="182"/>
            <TextBox TextWrapping="Wrap" Text="" x:Name="bookText" Width="122" Height="70"/>
            <TextBox x:Name="BookAuthortext" TextWrapping="Wrap" Text="" Width="118" Height="64"/>
            <Label Content="Book" FontSize="20" Height="46" Width="72"/>
            <Button Content="Hozzáad" Height="61" Width="150" Background="{x:Null}" Click="Button_Click"/>
            <Label Content="Authors Azonosító" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <DatePicker x:Name="BookDatePicker" HorizontalAlignment="Center" VerticalAlignment="Center" Height="78" Width="140"/>
            <Label FontSize="20" Content="Kiadás dátuma" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <TextBox x:Name="BookCategoriestext" HorizontalAlignment="Left" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="150" Height="78"/>
            <Label FontSize="20" Content="Categories Azonosító" HorizontalAlignment="Left" Margin="126,285,0,0" VerticalAlignment="Top" Width="150"/>
        </StackPanel>
    </Grid>
</Page>
