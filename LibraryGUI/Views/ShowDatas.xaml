<Page x:Class="LibraryGUI.Views.ShowDatas"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LibraryGUI.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ShowDatas">

    <Grid>
        <Menu>
            <MenuItem Header="_Read" Background="#FFF50000">
                <MenuItem Header="Authors" Click="MenuItem_Click_1"/>
                <MenuItem Header="Categories" Click="MenuItem_Click"/>
                <MenuItem Header="Books" Click="MenuItem_Click_2"/>
                <MenuItem Header="AuthorsBooks" Click="MenuItem_Click_3" />
            </MenuItem>

            <MenuItem Header="_Create" Background="#FF0056FF">
                <MenuItem Click="CreateAuthorsMenu" Header="Authors"/>
                <MenuItem Click="CreateCategoriesMenu" Header="Categories"/>
                <MenuItem Click="CreateBooksMenu" Header="Books"/>
            </MenuItem>

            <MenuItem Header="_Update" Background="#FF88FF00">
                <MenuItem Header="Authors"/>
                <MenuItem Header="Categories"/>
                <MenuItem Header="Books"/>
            </MenuItem>

            <MenuItem Header="_Delete" Height="36" Width="51" Background="#FF0CFFEE">
                <MenuItem Click="DeleteAuthorMenu" Header="Authors"/>
                <MenuItem Click="DeleteCategoriesMenu" Header="Categories"/>
                <MenuItem Click="DeleteBookMenu" Header="Books"/>
            </MenuItem>
        </Menu>
        <DataGrid x:Name="dataGrid1" AutoGenerateColumns="True" Margin="10,44,10,10"/>
    </Grid>
</Page>